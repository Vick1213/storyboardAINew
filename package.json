{
  "name": "storyboardai",
  "version": "0.0.0",
  "private": true,
  "description": "Claude Code, but for writing stories — multimodal, globally-synced, AWS-native.",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "deploy": "pnpm --filter @storyboard/infra deploy",
    "synth": "pnpm --filter @storyboard/infra synth"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "turbo": "^2.3.0",
    "typescript": "^5.6.3"
  }
}
