# Copy to .env and fill in after `cdk deploy` prints the CfnOutputs.
AWS_REGION=us-west-2

# From CDK outputs:
NEXT_PUBLIC_AWS_REGION=us-west-2
NEXT_PUBLIC_USER_POOL_ID=
NEXT_PUBLIC_USER_POOL_CLIENT_ID=
NEXT_PUBLIC_GRAPHQL_URL=
NEXT_PUBLIC_STREAMING_URL=
NEXT_PUBLIC_MEDIA_BUCKET=

# Bedrock model id for the writing agent. MUST be enabled in the Bedrock console
# (Model access) for us-west-2. Use an inference-profile id where required.
# NOTE: claude-3-5-sonnet-20241022-v2 was RETIRED from Bedrock (EOL). Current default:
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6
