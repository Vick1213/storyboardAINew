{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "cdk.out/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "synth": {
      "cache": false
    },
    "deploy": {
      "cache": false,
      "dependsOn": ["^build"]
    }
  }
}
